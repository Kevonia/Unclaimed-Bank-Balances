# Use official Python 3.10 image as base
FROM python:3.10-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV DASH_DEBUG_MODE False
ENV PORT 8050

# Create a non-root user and switch to it
RUN useradd -m dashboarduser && \
    mkdir -p /app && \
    chown dashboarduser:dashboarduser /app
USER dashboarduser
WORKDIR /app

# Install system dependencies (as root temporarily)
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*
USER dashboarduser

# Copy requirements first to leverage Docker cache
COPY --chown=dashboarduser:dashboarduser requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --user -r requirements.txt

# Ensure user's local bin is in PATH
ENV PATH="/home/dashboarduser/.local/bin:${PATH}"

# Copy application code
COPY --chown=dashboarduser:dashboarduser . .

# Expose the port the app runs on
EXPOSE $PORT

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:$PORT/_dash-health-check || exit 1

# Command to run the application
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:$PORT --workers $((2 * $(nproc --all) + 1)) --threads 2 --timeout 120 main:server"]